<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DramViewer.MainWindow"
        Title="DRAM Test Viewer" Width="960" Height="540">

    <DockPanel Margin="12">
        <!-- 상단: CSV 경로 + 불러오기 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="PathBox" Width="430" PlaceholderText="dram_test_results.csv 경로"/>
            <Button Content="CSV 불러오기" Click="OnLoadClick"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center"
                       Text="경로 확인 후 [CSV 불러오기]를 누르세요"/>
        </StackPanel>

        <!-- 필터 -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <TextBlock Text="필터" VerticalAlignment="Center"/>
            <ComboBox x:Name="FilterBox" Width="130" SelectedIndex="0" SelectionChanged="OnViewChanged">
                <ComboBoxItem>전체</ComboBoxItem>
                <ComboBoxItem>escape만</ComboBoxItem>
                <ComboBoxItem>PASS</ComboBoxItem>
                <ComboBoxItem>FAIL</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="노란 행 = escape (PASS인데 ECC 정정 발생)"
                       VerticalAlignment="Center" Opacity="0.7"/>
        </StackPanel>

        <!-- 테이블 헤더 + 행 목록 (고정폭 폰트로 열 맞춤) -->
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" Margin="0,12,0,4"
                   FontFamily="Menlo,Consolas,monospace" FontSize="12" FontWeight="Bold"/>
        <ListBox x:Name="RowsList" FontFamily="Menlo,Consolas,monospace" FontSize="12">
            <!-- 한 행을 어떻게 그릴지: 글자는 Text, 배경은 RowColor -->
            <ListBox.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                    <TextBlock Text="{Binding Text}" Background="{Binding RowColor}"
                               Foreground="{Binding TextColor}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
